# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
[Aa]ssets/AssetStoreTools*

# Autogenerated cache and temp files
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored if the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated Economy / Builder files & meta
[Aa]ssets/[Rr]esources.meta
[Aa]ssets/[Rr]esources/EconomyDatabase.asset
[Aa]ssets/[Rr]esources/EconomyDatabase.asset.meta
[Aa]ssets/[Ss]cripts/[Ii]nventory/EconomyDatabaseSO.cs.meta

# Autogenerated VS/MD/Consulo/Rider solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.opendb
.vs/
.vsconfig
.idea/
*.DotSettings.user

# Unity3D generated meta files & PlasticSCM / Version Control
*.pidb.meta
*.pdb.meta
*.mdb.meta
.plastic/
plastic.selector

# Unity3D Generated File On Crash Reports & Test Runner
sysinfo.txt
*.stacktrace
InitTestScene*.unity*

# Builds
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.dll

# Crashlytics
crashlytics-build.properties

# Packed Addressables & StreamingAssets cache
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
[Aa]ssets/[Ss]treaming[Aa]ssets/aa.meta
[Aa]ssets/[Ss]treaming[Aa]ssets/aa/*

# Temporary cache & Unity UPM / Burst / Shader cache
.utmp/
.gradle/
**/Logs/

# OS generated files (Windows / macOS / Linux)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

# IDE & AI Assistant generated files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/
.cursor/
.gemini/
.antigravity/
*.swp
*.swo
*.bak
*.orig
